{
  "name": "dev-utils-vscode-plugin",
  "displayName": "DevUtils - Developer Utilities",
  "description": "All-in-one offline developer toolbox: Encoders, Formatters, Hash & UUID Generators, JWT Inspector, Case Converters, Line Tools and Webview Dashboard.",
  "version": "0.3.1",
  "publisher": "TechwastiInfotech",
  "repository": {
    "type": "git",
    "url": "https://github.com/Techwasti-Infotech/dev-utils-VSCode-plugin"
  },
  "homepage": "https://Techwasti-Infotech.github.io/dev-utils-VSCode-plugin/",
  "bugs": {
    "url": "https://github.com/Techwasti-Infotech/dev-utils-VSCode-plugin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Techwasti Infotech",
    "email": "techwastiinfotech@gmail.com",
    "url": "https://techwasti.com"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "devutils",
    "utilities",
    "base64",
    "jwt",
    "json",
    "xml",
    "uuid",
    "hash",
    "formatter",
    "timestamp",
    "offline"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devutils.openDashboard",
        "title": "Open Developer Dashboard",
        "category": "DevUtils",
        "icon": "$(tools)"
      },
      {
        "command": "devutils.base64Encode",
        "title": "Base64: Encode Selection",
        "category": "DevUtils"
      },
      {
        "command": "devutils.base64Decode",
        "title": "Base64: Decode Selection",
        "category": "DevUtils"
      },
      {
        "command": "devutils.urlEncode",
        "title": "URL: Encode Selection",
        "category": "DevUtils"
      },
      {
        "command": "devutils.urlDecode",
        "title": "URL: Decode Selection",
        "category": "DevUtils"
      },
      {
        "command": "devutils.htmlEncode",
        "title": "HTML: Encode Entities",
        "category": "DevUtils"
      },
      {
        "command": "devutils.htmlDecode",
        "title": "HTML: Decode Entities",
        "category": "DevUtils"
      },
      {
        "command": "devutils.hexEncode",
        "title": "Hex: Encode Text to Hex",
        "category": "DevUtils"
      },
      {
        "command": "devutils.hexDecode",
        "title": "Hex: Decode Hex to Text",
        "category": "DevUtils"
      },
      {
        "command": "devutils.jsonFormat",
        "title": "JSON: Format / Prettify",
        "category": "DevUtils"
      },
      {
        "command": "devutils.jsonMinify",
        "title": "JSON: Minify / Compact",
        "category": "DevUtils"
      },
      {
        "command": "devutils.xmlFormat",
        "title": "XML: Format / Prettify",
        "category": "DevUtils"
      },
      {
        "command": "devutils.xmlMinify",
        "title": "XML: Minify / Compact",
        "category": "DevUtils"
      },
      {
        "command": "devutils.sqlFormat",
        "title": "SQL: Format Query",
        "category": "DevUtils"
      },
      {
        "command": "devutils.csvToJson",
        "title": "CSV: Convert CSV to JSON",
        "category": "DevUtils"
      },
      {
        "command": "devutils.jsonToCsv",
        "title": "JSON: Convert JSON to CSV",
        "category": "DevUtils"
      },
      {
        "command": "devutils.jwtDecode",
        "title": "JWT: Inspect & Decode Token",
        "category": "DevUtils"
      },
      {
        "command": "devutils.generateUUID",
        "title": "Generate: UUID v4 (Insert at cursor)",
        "category": "DevUtils"
      },
      {
        "command": "devutils.generateNanoid",
        "title": "Generate: Nanoid (Insert at cursor)",
        "category": "DevUtils"
      },
      {
        "command": "devutils.generateLorem",
        "title": "Generate: Lorem Ipsum Paragraph",
        "category": "DevUtils"
      },
      {
        "command": "devutils.timestampToDate",
        "title": "Timestamp: Epoch to Human Date",
        "category": "DevUtils"
      },
      {
        "command": "devutils.currentTimestamp",
        "title": "Timestamp: Insert Current Epoch",
        "category": "DevUtils"
      },
      {
        "command": "devutils.hashSha256",
        "title": "Hash: Generate SHA-256 Checksum",
        "category": "DevUtils"
      },
      {
        "command": "devutils.hashMd5",
        "title": "Hash: Generate MD5 Checksum",
        "category": "DevUtils"
      },
      {
        "command": "devutils.caseCamel",
        "title": "Case: Convert to camelCase",
        "category": "DevUtils"
      },
      {
        "command": "devutils.caseSnake",
        "title": "Case: Convert to snake_case",
        "category": "DevUtils"
      },
      {
        "command": "devutils.caseKebab",
        "title": "Case: Convert to kebab-case",
        "category": "DevUtils"
      },
      {
        "command": "devutils.casePascal",
        "title": "Case: Convert to PascalCase",
        "category": "DevUtils"
      },
      {
        "command": "devutils.caseConstant",
        "title": "Case: Convert to CONSTANT_CASE",
        "category": "DevUtils"
      },
      {
        "command": "devutils.caseTitle",
        "title": "Case: Convert to Title Case",
        "category": "DevUtils"
      },
      {
        "command": "devutils.sortLines",
        "title": "Text: Sort Lines A-Z",
        "category": "DevUtils"
      },
      {
        "command": "devutils.deduplicateLines",
        "title": "Text: Deduplicate Lines",
        "category": "DevUtils"
      },
      {
        "command": "devutils.textStats",
        "title": "Text: Show Word/Line/Byte Stats",
        "category": "DevUtils"
      },
      {
        "command": "devutils.curlToFetch",
        "title": "cURL: Convert to JavaScript Fetch",
        "category": "DevUtils"
      },
      {
        "command": "devutils.curlToPython",
        "title": "cURL: Convert to Python Requests",
        "category": "DevUtils"
      },
      {
        "command": "devutils.jsonToTs",
        "title": "JSON: Generate TypeScript Interfaces",
        "category": "DevUtils"
      },
      {
        "command": "devutils.explainCron",
        "title": "Cron: Humanize & Explain Expression",
        "category": "DevUtils"
      }
    ],
    "keybindings": [
      {
        "command": "devutils.openDashboard",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "devutils.base64Encode",
        "key": "ctrl+alt+b e",
        "mac": "cmd+alt+b e",
        "when": "editorHasSelection"
      },
      {
        "command": "devutils.base64Decode",
        "key": "ctrl+alt+b d",
        "mac": "cmd+alt+b d",
        "when": "editorHasSelection"
      },
      {
        "command": "devutils.jsonFormat",
        "key": "ctrl+alt+j f",
        "mac": "cmd+alt+j f",
        "when": "editorTextFocus"
      },
      {
        "command": "devutils.jsonMinify",
        "key": "ctrl+alt+j m",
        "mac": "cmd+alt+j m",
        "when": "editorTextFocus"
      },
      {
        "command": "devutils.jwtDecode",
        "key": "ctrl+alt+j w",
        "mac": "cmd+alt+j w"
      },
      {
        "command": "devutils.generateUUID",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus"
      },
      {
        "command": "devutils.currentTimestamp",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      },
      {
        "command": "devutils.sortLines",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devutils.submenu",
          "group": "1_modification"
        }
      ],
      "devutils.submenu": [
        {
          "command": "devutils.openDashboard"
        },
        {
          "command": "devutils.base64Encode"
        },
        {
          "command": "devutils.base64Decode"
        },
        {
          "command": "devutils.urlEncode"
        },
        {
          "command": "devutils.urlDecode"
        },
        {
          "command": "devutils.htmlEncode"
        },
        {
          "command": "devutils.htmlDecode"
        },
        {
          "command": "devutils.hexEncode"
        },
        {
          "command": "devutils.hexDecode"
        },
        {
          "command": "devutils.jsonFormat"
        },
        {
          "command": "devutils.jsonMinify"
        },
        {
          "command": "devutils.xmlFormat"
        },
        {
          "command": "devutils.xmlMinify"
        },
        {
          "command": "devutils.sqlFormat"
        },
        {
          "command": "devutils.csvToJson"
        },
        {
          "command": "devutils.jsonToCsv"
        },
        {
          "command": "devutils.jwtDecode"
        },
        {
          "command": "devutils.generateUUID"
        },
        {
          "command": "devutils.generateNanoid"
        },
        {
          "command": "devutils.generateLorem"
        },
        {
          "command": "devutils.hashSha256"
        },
        {
          "command": "devutils.hashMd5"
        },
        {
          "command": "devutils.timestampToDate"
        },
        {
          "command": "devutils.currentTimestamp"
        },
        {
          "command": "devutils.caseCamel"
        },
        {
          "command": "devutils.caseSnake"
        },
        {
          "command": "devutils.caseKebab"
        },
        {
          "command": "devutils.casePascal"
        },
        {
          "command": "devutils.caseConstant"
        },
        {
          "command": "devutils.caseTitle"
        },
        {
          "command": "devutils.sortLines"
        },
        {
          "command": "devutils.deduplicateLines"
        },
        {
          "command": "devutils.textStats"
        },
        {
          "command": "devutils.curlToFetch"
        },
        {
          "command": "devutils.curlToPython"
        },
        {
          "command": "devutils.jsonToTs"
        },
        {
          "command": "devutils.explainCron"
        }
      ]
    },
    "submenus": [
      {
        "id": "devutils.submenu",
        "label": "DevUtils Toolbox"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node scripts/run-tests.js",
    "lint": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.3.3"
  }
}
